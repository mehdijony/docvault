# .env.example
# Copy to .env and fill in values

# Application
NODE_ENV=development
API_PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=docvault
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/docvault

# Keycloak
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=docvault
KEYCLOAK_CLIENT_ID=docvault-api
KEYCLOAK_CLIENT_SECRET=your-client-secret
KEYCLOAK_ADMIN_CLIENT_ID=admin-cli
KEYCLOAK_ADMIN_PASSWORD=admin

# MinIO
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET_DOCUMENTS=documents
MINIO_BUCKET_THUMBNAILS=thumbnails

# RabbitMQ
RABBITMQ_URL=amqp://admin:admin@localhost:5672
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=admin

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=docvault-api
KAFKA_GROUP_ID=docvault-consumers
KAFKAJS_NO_PARTITIONER_WARNING=1

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis

# Vault
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=root

# Kong
KONG_ADMIN_URL=http://localhost:8001

# Grafana
GRAFANA_PASSWORD=admin

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Email (MailHog for dev)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@docvault.dev